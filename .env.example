# Copy to .env for local runs. On Render set these in Environment. Never commit real values.

# ---- PostgreSQL ----
DATABASE_URL=postgresql://user:pass@host:5432/integration   # Render internal URL

# ---- Zoho CRM (Self Client, Autotechno admin account) ----
ZOHO_DC=eu                       # com | eu | in | ...
ZOHO_API_VERSION=v8
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_URL=https://crm.zoho.eu/crm/org<ORG_ID>
ZOHO_STAGE_CONTRACTING=Contracting
ZOHO_STAGE_CLOSED=Closed Deal
ZOHO_FIELD_WIN=WIN_Code
ZOHO_FIELD_IDENT=Identification_Code

# ---- ClickUp (service user token) ----
CLICKUP_TOKEN=
CLICKUP_TEAM_ID=
CLICKUP_SERVICE_USER_ID=         # its own changes are ignored by webhooks (loop guard)
CLICKUP_EXECUTION_SPACE_ID=      # space "გარიგებების შესრულება" (F3/F4)
CLICKUP_CONTRACTS_LIST_ID=       # list "კონტრაქტების რეგისტრაცია" (F7)
CLICKUP_INCIDENTS_LIST_ID=       # list "ინტეგრაცია: ინციდენტები"
CLICKUP_WEBHOOK_SECRET=          # printed by scripts/register_clickup_webhooks.py
CLICKUP_CONTRACTS_WEBHOOK_SECRET=

# ---- Balance (read-only user) ----
BALANCE_BASE_URL=https://cloud.balance.ge/sm/o/Balance/<ApplicationID>/hs/Exchange
BALANCE_USER=
BALANCE_PASS=
BALANCE_NODE_CODE=
BALANCE_CHANGE_HEADER=LastChangeNumber   # confirm on the real API
BALANCE_PRICE_TYPE=                      # price type written to Zoho Unit_Price
BALANCE_WAREHOUSES=                      # comma-separated; empty = all warehouses

# ---- Middleware ----
INBOUND_TOKEN=                   # same value as Zoho Org Variable INT_TOKEN
TZ_NAME=Asia/Tbilisi
RUN_SCHEDULER=true
LOG_LEVEL=INFO
# Kill switches (rollback): FLOW_F1_ENABLED=false etc.
